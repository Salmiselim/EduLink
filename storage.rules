rules_version = '2';

// ============================================================================
// RÈGLES FIREBASE STORAGE — EduLink (module Cours)
// Déploiement : firebase deploy --only storage
// ============================================================================
// Stockage facturable : chaque règle limite au strict nécessaire.
// - Lecture : tout utilisateur CONNECTÉ (les download URL restent protégés).
// - Écriture : l'enseignant PROPRIÉTAIRE du cours uniquement (rôle vérifié
//   dans Firestore), chemin par chemin, avec type et taille imposés.
// - Suppression : l'enseignant propriétaire uniquement.
// - Tout le reste est refusé par défaut (aucun match = accès refusé).
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // L'auteur du cours doit être l'utilisateur connecté (vérification
    // croisée dans Firestore : collection `courses`, champ `teacherId`).
    function isCourseTeacher(courseId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    // ── Documents PDF des chapitres ────────────────────────────────────────
    // Un seul niveau de répertoire, PDF authentique déclaré, 20 Mo maximum.
    match /courses/{courseId}/chapters/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isCourseTeacher(courseId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf');
      allow delete: if isCourseTeacher(courseId);
    }

    // ── Image de couverture du cours ───────────────────────────────────────
    // Fichier unique à la racine du cours, nom imposé « cover_… »,
    // image déclarée, 10 Mo maximum (pas de sous-répertoires ici).
    match /courses/{courseId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isCourseTeacher(courseId)
        && fileName.matches('cover_.*\\.(jpg|jpeg|png)')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCourseTeacher(courseId);
    }
  }
}
